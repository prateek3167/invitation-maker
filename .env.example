# Local accounts work without configuration; their database/secret live in ignored .data/.
# Copy this file to apps/web/.env.local when configuring the Next.js app.
PUBLIC_APP_URL=http://127.0.0.1:3000
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/invitation_maker?sslmode=verify-full
# BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_DEPLOYMENT=true
# LOCAL_DATABASE_PATH=.data/postgres
# Local verification/reset mail is captured in .data/mailbox; inspect with npm run mail:preview -- EMAIL.
# SMTP_URL=smtps://USERNAME:PASSWORD@HOST:465
# MAIL_FROM=Invitation Maker <no-reply@YOUR_DOMAIN>
# MAIL_CAPTURE_DIRECTORY=.data/mailbox
# Public web/worker instances require shared durable private mounts outside public/.
# PRIVATE_MEDIA_DIRECTORY=ABSOLUTE_PRIVATE_MEDIA_PATH
# PRIVATE_EXPORT_DIRECTORY=ABSOLUTE_PRIVATE_EXPORT_PATH
# EXPORT_BROWSER_CHANNEL=chrome
# EXPORT_BROWSER_EXECUTABLE=ABSOLUTE_CONTROLLED_CHROME_EXECUTABLE
# Offline local recovery: keep this managed 64-hex-character key separately from backups.
# BACKUP_ENCRYPTION_KEY=
