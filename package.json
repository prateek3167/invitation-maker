{
  "name": "invitation-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @invitation/web",
    "build": "npm run build --workspace @invitation/web",
    "start": "npm run start --workspace @invitation/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "check:structure": "node scripts/check-structure.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "mail:preview": "node scripts/mailbox.mjs",
    "admin:promote": "node scripts/admin-promote.mjs",
    "worker:exports": "node scripts/run-export-worker.mjs",
    "recovery": "node scripts/run-recovery.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "storage:maintain": "node scripts/run-maintenance.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "better-auth": "1.7.22",
    "drizzle-orm": "0.45.4",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "playwright-core": "1.65.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "jsqr": "1.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.51.0": true
  }
}
